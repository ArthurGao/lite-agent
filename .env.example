# Copy to .env (gitignored). Every setting has the LITEAGENT_ prefix (design §11).
# The PostgreSQL session store (extra `pg`): one database per project on the shared server.
LITEAGENT_DATABASE_URL=postgresql://lite_agent:CHANGE_ME@localhost:5432/lite_agent
# LITEAGENT_SCHEMA=lite_agent
# Tests use only the schema lite_agent_test (dropped and recreated); set explicitly, never
# inherited from the app's URL. Run them with `uv run --env-file .env pytest`.
LITEAGENT_TEST_DATABASE_URL=postgresql://lite_agent:CHANGE_ME@localhost:5432/lite_agent
